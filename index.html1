<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Orbit Care Exchange — AI Coordination MVP</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Serif+Display&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css" />
<style>
*{box-sizing:border-box;margin:0;padding:0}:root{--b50:#E6F1FB;--b100:#B5D4F4;--b200:#85B7EB;--b400:#378ADD;--b600:#185FA5;--b800:#0C447C;--b900:#042C53;--a50:#FAEEDA;--a100:#FAC775;--a800:#633806;--r50:#FCEBEB;--r100:#F7C1C1;--r400:#E24B4A;--r800:#791F1F;--g50:#EAF3DE;--g100:#C0DD97;--g700:#0F6E56;--g800:#27500A;--p50:#F1F0FE;--p100:#CECBF6;--p800:#3C3489;--font:'DM Sans',sans-serif;--serif:'DM Serif Display',serif;--radius:12px;--radius-lg:16px;--radius-xl:24px;--shadow:0 1px 3px rgba(4,44,83,.06),0 8px 24px rgba(4,44,83,.07);--shadow-lg:0 14px 40px rgba(4,44,83,.14)}
body{background:#f8f9fc;font-family:var(--font);color:var(--b900);font-size:14px;line-height:1.5}
.topnav{background:#fff;border-bottom:1px solid var(--b100);padding:0 2rem;display:flex;align-items:center;justify-content:space-between;height:58px;position:sticky;top:0;z-index:100;box-shadow:var(--shadow)}
.logo{font-family:var(--serif);font-size:19px;color:var(--b800);display:flex;align-items:center;gap:8px}
.logo i{font-size:22px;color:var(--b600)}
.tabs{display:flex;gap:2px}
.tab{padding:7px 18px;border-radius:24px;font-size:13px;font-weight:500;cursor:pointer;border:none;background:transparent;color:var(--b600);transition:all .2s;font-family:var(--font)}
.tab:hover{background:var(--b50)}
.tab.active{background:var(--b600);color:#fff}
.section{display:none;padding:1.5rem 2rem;max-width:1300px;margin:0 auto}
.section.active{display:block}
.grid2{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.5fr);gap:16px;align-items:start}
.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.grid4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:16px}
.card{background:#fff;border:1px solid var(--b100);border-radius:var(--radius-lg);padding:1.2rem 1.4rem;margin-bottom:14px;box-shadow:var(--shadow)}
.card-blue{background:var(--b50);border:1px solid var(--b100)}
.card-title{font-size:13px;font-weight:600;color:var(--b800);text-transform:uppercase;letter-spacing:.5px;margin-bottom:1rem;display:flex;align-items:center;gap:6px}
.card-title i{font-size:16px}
.metric{background:var(--b50);border:1px solid var(--b100);border-radius:var(--radius);padding:1rem 1.1rem}
.metric-lbl{font-size:11px;font-weight:500;color:var(--b600);text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px;display:flex;align-items:center;gap:5px}
.metric-val{font-size:26px;font-weight:300;color:var(--b900);margin-bottom:2px}
.metric-sub{font-size:11px;color:var(--b600)}
.badge{font-size:11px;padding:3px 10px;border-radius:20px;font-weight:600;white-space:nowrap;display:inline-flex;align-items:center;gap:3px}
.badge-red{background:var(--r50);color:var(--r800);border:1px solid var(--r100)}
.badge-amber{background:var(--a50);color:var(--a800);border:1px solid var(--a100)}
.badge-blue{background:var(--b50);color:var(--b800);border:1px solid var(--b100)}
.badge-green{background:var(--g50);color:var(--g800);border:1px solid var(--g100)}
.av{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:600;flex-shrink:0}
.av-b{background:var(--b100);color:var(--b900)}
.av-t{background:#9FE1CB;color:#04342C}
.av-a{background:#FAC775;color:#412402}
.av-c{background:#F5C4B3;color:#4A1B0C}
.av-p{background:var(--p100);color:var(--p800)}
.case-row{display:flex;align-items:flex-start;gap:12px;padding:12px;cursor:pointer;border-radius:var(--radius);border:1px solid transparent;transition:all .15s;margin-bottom:8px}
.case-row:hover{background:var(--b50);border-color:var(--b100)}
.case-row.sel{background:var(--b50);border-color:var(--b600);border-width:2px;padding:11px}
.case-info{flex:1;min-width:0}
.case-name{font-size:14px;font-weight:600;color:var(--b900);margin-bottom:2px}
.case-sub{font-size:12px;color:var(--b600);margin-bottom:4px}
.case-detail{font-size:12px;color:var(--b600)}
.case-reason{font-size:13px;color:var(--b800);line-height:1.6;background:var(--b50);padding:10px 12px;border-radius:var(--radius);border:1px solid var(--b100);margin:8px 0}
.action-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:6px}
.action-tag{font-size:11px;padding:3px 8px;background:#fff;border:1px solid var(--b100);border-radius:20px;color:var(--b800);font-weight:500}
.bar-row{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.bar-lbl{font-size:12px;color:var(--b600);width:110px;flex-shrink:0}
.bar-track{flex:1;height:7px;background:var(--b50);border-radius:4px;overflow:hidden;border:1px solid var(--b100)}
.bar-fill{height:100%;border-radius:4px;transition:width .6s ease;background:var(--b600)}
.bar-pct{font-size:12px;font-weight:600;color:var(--b900);width:32px;text-align:right}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:10px 18px;border-radius:var(--radius);font-size:13px;font-weight:600;cursor:pointer;border:none;font-family:var(--font);transition:all .2s}
.btn-primary{background:var(--b600);color:#fff;box-shadow:0 2px 8px rgba(24,95,165,.2)}
.btn-primary:hover{background:var(--b800);box-shadow:0 4px 12px rgba(24,95,165,.3)}
.btn-outline{background:#fff;color:var(--b600);border:1px solid var(--b600)}
.btn-outline:hover{background:var(--b50)}
.btn-green{background:var(--g700);color:#fff;box-shadow:0 2px 8px rgba(15,110,86,.2)}
.btn-green:hover{background:var(--g800);box-shadow:0 4px 12px rgba(15,110,86,.3)}
.btn-amber{background:#BA7517;color:#fff}
.btn-amber:hover{background:var(--a800)}
.btn-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
.triage-box{background:var(--b50);border:1px solid var(--b100);border-radius:var(--radius);padding:12px}
.trow{display:flex;justify-content:space-between;align-items:center;padding:6px 0;font-size:13px;border-bottom:1px solid var(--b100)}
.trow:last-child{border-bottom:none}
.tk{color:var(--b600);font-weight:500}
.tv{font-weight:600;color:var(--b900)}
.urgbar{height:8px;background:var(--b50);border-radius:4px;border:1px solid var(--b100);overflow:hidden;margin:6px 0}
.urgbar-fill{height:100%;border-radius:4px}
.step-row{display:flex;align-items:flex-start;gap:10px;padding:10px 0;border-bottom:1px solid var(--b50)}
.step-row:last-child{border-bottom:none}
.snum{width:26px;height:26px;border-radius:50%;background:var(--b50);color:var(--b600);font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;border:1px solid var(--b100)}
.snum.done{background:var(--g700);color:#fff;border-color:var(--g700)}
.stxt{font-size:13px;color:var(--b900);flex:1;line-height:1.5}
.sstatus{font-size:11px;font-weight:600;white-space:nowrap;padding-top:2px;color:var(--b600)}
.mrow{display:flex;align-items:center;gap:10px;padding:10px 8px;border-bottom:1px solid var(--b50);cursor:pointer;border-radius:var(--radius);transition:background .15s}
.mrow:last-child{border-bottom:none}
.mrow:hover{background:var(--b50)}
.mrow.picked{background:var(--b50);border-left:3px solid var(--b600);padding-left:6px}
.mi{width:32px;height:32px;border-radius:var(--radius);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.mi-b{background:var(--b100);color:var(--b800)}
.mi-t{background:#9FE1CB;color:#085041}
.mi-a{background:#FAC775;color:#633806}
.mi-p{background:var(--p100);color:var(--p800)}
.mi-g{background:var(--g100);color:var(--g800)}
.minfo{flex:1;min-width:0}
.mname{font-size:13px;font-weight:600;color:var(--b900)}
.msub{font-size:11px;color:var(--b600);margin-top:1px}
.mcost{font-size:11px;color:#888;margin-top:2px}
.mscore{font-size:13px;font-weight:700;color:var(--g700);flex-shrink:0}
.checkmark{width:20px;height:20px;border-radius:4px;border:2px solid var(--b100);background:transparent;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .15s;color:transparent}
.checkmark i{font-size:12px}
.mrow.picked .checkmark{background:var(--b600);border-color:var(--b600);color:#fff}
.match-row{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--b50)}
.match-row:last-child{border-bottom:none}
.match-icon{width:32px;height:32px;border-radius:var(--radius);display:flex;align-items:center;justify-content:center;flex-shrink:0;background:var(--b100);color:var(--b800)}
.match-info{flex:1;min-width:0}
.match-name{font-size:13px;font-weight:600;color:var(--b900)}
.match-detail{font-size:11px;color:var(--b600);margin-top:2px}
.match-pct{font-size:13px;font-weight:700;color:var(--g700)}
input,select,textarea{font-family:var(--font);font-size:13px;width:100%;padding:9px 12px;border:1px solid var(--b100);border-radius:var(--radius);background:#fff;color:var(--b900);transition:border .15s;margin-bottom:10px}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--b600);box-shadow:0 0 0 3px rgba(24,95,165,.1)}
label{font-size:12px;color:var(--b800);display:block;margin-bottom:4px;font-weight:600}
.small-note{font-size:12px;color:var(--b600);line-height:1.6}
.empty{text-align:center;padding:2.5rem 1rem;color:var(--b600)}
.empty i{font-size:32px;display:block;margin-bottom:10px;color:var(--b100)}
.empty p{font-size:13px}
.tl-item{display:flex;gap:10px;padding:5px 0}
.tl-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;margin-top:6px}
.tl-txt{font-size:12px;color:var(--b600);flex:1;line-height:1.6}
.oc-card{background:var(--b50);border:1px solid var(--b100);border-radius:var(--radius);padding:12px;margin-bottom:10px}
.next-action{display:flex;align-items:flex-start;gap:10px;margin-bottom:8px}
.next-action-num{width:24px;height:24px;border-radius:50%;background:var(--b600);color:#fff;font-size:11px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.apikey-banner{background:linear-gradient(135deg,var(--b800),var(--b600));color:#fff;padding:12px 16px;border-radius:var(--radius);margin-bottom:16px;display:flex;align-items:center;gap:12px}
.apikey-banner.connected{background:linear-gradient(135deg,var(--g700),var(--g800))}
.apikey-banner i{font-size:20px}
.apikey-content{flex:1}
.apikey-status{font-size:11px;opacity:.9;margin-top:2px}
.event-log{margin-top:12px;max-height:300px;overflow-y:auto;border:1px solid var(--b100);border-radius:var(--radius);padding:10px;background:var(--b50)}
.event-item{display:flex;gap:10px;margin-bottom:10px;font-size:12px}
.event-item:last-child{margin-bottom:0}
.event-dot{width:8px;height:8px;border-radius:50%;background:var(--b600);flex-shrink:0;margin-top:4px}
.timeline-card{background:var(--b50);border:1px solid var(--b100);border-radius:var(--radius);padding:10px;margin-bottom:8px}
@keyframes spin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
</style>
</head>
<body>
<nav class="topnav">
  <div class="logo"><i class="ti ti-planet"></i>Orbit Care Exchange</div>
  <div class="tabs">
    <button class="tab active" onclick="showTab('overview',this)">Overview</button>
    <button class="tab" onclick="showTab('intake',this)">Live intake</button>
    <button class="tab" onclick="showTab('caseflow',this)">Case flow</button>
    <button class="tab" onclick="showTab('exchange',this)">Exchange</button>
    <button class="tab" onclick="showTab('outcomes',this)">Outcomes</button>
  </div>
</nav>

<section id="tab-overview" class="section active">
  <div class="apikey-banner" id="apikey-banner">
    <i class="ti ti-key"></i>
    <div class="apikey-content">
      <div style="font-weight:600;font-size:14px">Claude AI Integration</div>
      <div class="apikey-status" id="apikey-status">Status: Demo mode. Intake will use local rules unless an API key is connected.</div>
    </div>
    <input type="text" id="apikey-input" placeholder="sk-ant-api..." style="max-width:280px;margin:0;padding:8px 12px;font-size:12px">
    <button class="btn btn-primary" onclick="saveApiKey()" style="padding:8px 16px">Connect</button>
    <button class="btn btn-outline" onclick="clearApiKey()" style="padding:8px 16px">Clear</button>
  </div>
  <div class="grid4">
    <div class="metric"><div class="metric-lbl"><i class="ti ti-users"></i>Active cases</div><div class="metric-val" id="m-active">18</div><div class="metric-sub">Being coordinated</div></div>
    <div class="metric"><div class="metric-lbl"><i class="ti ti-alert-circle"></i>Urgent cases</div><div class="metric-val" style="color:var(--r400)" id="m-urgent">5</div><div class="metric-sub">Score ≥ 80/100</div></div>
    <div class="metric"><div class="metric-lbl"><i class="ti ti-cpu"></i>AI triaged</div><div class="metric-val" style="color:var(--g700)" id="m-triaged">18</div><div class="metric-sub">This session</div></div>
    <div class="metric"><div class="metric-lbl"><i class="ti ti-chart-line"></i>Avg match</div><div class="metric-val" style="color:var(--b600)">92%</div><div class="metric-sub">Confidence</div></div>
  </div>
  <div class="grid2">
    <div class="card">
      <div class="card-title"><i class="ti ti-inbox"></i>Case queue — click to open flow</div>
      <div id="overview-cases"></div>
    </div>
    <div>
      <div class="card">
        <div class="card-title"><i class="ti ti-map-pin"></i>Cases by town</div>
        <div id="town-bars"></div>
      </div>
    </div>
  </div>
</section>

<section id="tab-intake" class="section">
  <div class="card" style="max-width:700px;margin:0 auto">
    <div class="card-title"><i class="ti ti-forms"></i>Live case intake with AI triage</div>
    <div class="grid2" style="grid-template-columns:1fr 1fr">
      <div><label>Elder's name</label><input type="text" id="in-name" placeholder="e.g. Mdm Lee Siew Lan"></div>
      <div><label>Age</label><input type="number" id="in-age" placeholder="84"></div>
    </div>
    <label>Town / estate</label>
    <select id="in-town"><option value="">Select town…</option><option>Tampines</option><option>Yishun</option><option>Bedok</option><option>Jurong West</option><option>Ang Mo Kio</option><option>Geylang</option><option>Toa Payoh</option><option>Bukit Panjang</option><option>Woodlands</option><option>Sengkang</option></select>
    <label>Primary care need</label>
    <select id="in-need"><option value="">Select need…</option><option>Dementia / memory care</option><option>Post-surgery rehab</option><option>Diabetes management</option><option>Daily meals & nutrition</option><option>Mobility & transport</option><option>Stroke recovery</option><option>Mental health support</option><option>End-of-life / palliative</option><option>Fall risk / mobility support</option><option>Caregiver relief / burnout</option></select>
    <label>Family caregiver stress level</label>
    <select id="in-stress"><option value="">Select stress level…</option><option>Low — managing well</option><option>Medium — some strain</option><option>High — burnout risk</option><option>Critical — no caregiver</option></select>
    <label>Subsidy / financial tier</label>
    <select id="in-subsidy"><option value="">Select tier…</option><option>CHAS Blue (lowest income)</option><option>CHAS Orange</option><option>Pioneer / Merdeka Generation</option><option>MediShield Life only</option><option>Self-paying</option></select>
    <label>Case notes / situation description</label>
    <textarea id="in-notes" rows="4" placeholder="Describe the situation: living alone, recent discharge, fall risk, medication issues, family concerns, etc."></textarea>
    <div class="btn-row">
      <button class="btn btn-outline" onclick="runDemoScenario()"><i class="ti ti-sparkles"></i>Load demo scenario</button>
      <button class="btn btn-primary" id="submit-btn" onclick="submitIntake()" style="flex:1">
        <span id="spinner" style="display:none"><i class="ti ti-loader" style="animation:spin .7s linear infinite"></i></span>
        <span id="btn-text"><i class="ti ti-robot"></i> Run AI triage now</span>
      </button>
    </div>
    <div id="error-msg" style="display:none;background:var(--r50);border:1px solid var(--r100);border-radius:var(--radius);padding:10px;margin-top:10px;font-size:12px;color:var(--r800)">
      <i class="ti ti-alert-circle"></i> <span id="error-text"></span>
    </div>
  </div>
  <div class="card" style="max-width:700px;margin:16px auto 0" id="triage-placeholder">
    <div class="empty"><i class="ti ti-cpu"></i><p>Run AI triage to see urgency score, summary and next actions</p></div>
  </div>
  <div class="card" style="max-width:700px;margin:16px auto 0;display:none" id="triage-result">
    <div class="card-title"><i class="ti ti-cpu"></i>AI Triage result</div>
    <div class="triage-box">
      <div class="trow"><span class="tk">Urgency score</span><span class="tv" id="tr-score" style="font-size:20px">—</span></div>
      <div class="trow"><span class="tk">Assessment level</span><span class="tv"><span id="tr-badge" class="badge">—</span></span></div>
    </div>
    <div class="case-reason" style="margin-top:10px" id="tr-summary">—</div>
    <div style="margin-top:12px">
      <div style="font-size:12px;font-weight:600;color:var(--b800);margin-bottom:8px;text-transform:uppercase">Recommended next actions</div>
      <div id="tr-actions"></div>
    </div>
    <button class="btn btn-green" onclick="addLiveCaseToFlow()" style="width:100%;margin-top:12px"><i class="ti ti-arrow-right"></i>Add case to matching workflow</button>
  </div>
</section>

<section id="tab-caseflow" class="section">
  <div class="grid2">
    <div class="card">
      <div class="card-title"><i class="ti ti-list"></i>Select case for matching</div>
      <div id="flow-cases"></div>
    </div>
    <div id="case-right">
      <div class="card card-blue empty"><i class="ti ti-arrow-left"></i><p>Select a case from the left to begin coordination workflow</p></div>
    </div>
  </div>
</section>

<section id="tab-exchange" class="section">
  <div id="exchange-active-case"></div>
  <div class="grid2">
    <div class="card">
      <div class="card-title"><i class="ti ti-user-check"></i>Workers & care providers</div>
      <div id="worker-board"></div>
    </div>
    <div class="card">
      <div class="card-title"><i class="ti ti-salad"></i>Surplus food & resources</div>
      <div id="surplus-board"></div>
    </div>
  </div>
  <div class="card">
    <div class="card-title"><i class="ti ti-building-plus"></i>Add new partner to registry</div>
    <div class="grid2" style="grid-template-columns:1fr 1fr">
      <div><label>Partner name</label><input type="text" id="partner-name" placeholder="Organisation or worker name"></div>
      <div><label>Type</label><select id="partner-type"><option>Care provider</option><option>Worker</option><option>Surplus supplier</option></select></div>
    </div>
    <div class="grid2" style="grid-template-columns:1fr 1fr">
      <div><label>Coverage area</label><input type="text" id="partner-area" placeholder="e.g. Tampines, Bedok"></div>
      <div><label>Capacity</label><input type="text" id="partner-capacity" placeholder="e.g. 20 cases/month"></div>
    </div>
    <button class="btn btn-green" onclick="addPartner()"><i class="ti ti-plus"></i>Register new partner</button>
    <div class="event-log" id="partner-list" style="margin-top:12px;max-height:200px">
      <div class="event-item"><span class="event-dot"></span><span>New partners will appear here once registered.</span></div>
    </div>
  </div>
</section>

<section id="tab-outcomes" class="section">
  <div id="active-outcome-tracker"></div>
  <div class="card">
    <div class="card-title"><i class="ti ti-circle-check"></i>Fulfilled & closed-loop cases</div>
    <div id="fulfilled-list"></div>
  </div>
</section>

<script>
// ========================================
// GLOBAL STATE INITIALIZATION (FIXED)
// ========================================
function readSessionValue(key){
  return '';
}
function writeSessionValue(key,value){
  return;
}
function removeSessionValue(key){
  return;
}
let _apiKey = readSessionValue('orbit_api_key');
let selectedCase = -1;
let picks = {care:{}, work:{}, surp:{}};
let lastTriageData = null;
let activeOutcomePlan = null;

// ========================================
// DATA SOURCES
// ========================================
